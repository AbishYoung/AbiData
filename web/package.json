{
  "name": "abidata-web",
  "private": true,
  "version": "1.3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../internal/httpapi/openapi.json -o src/generated/api.d.ts",
    "gen:shortcuts": "node scripts/gen-shortcuts.mjs",
    "gen:icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@monaco-editor/react": "4.7.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-table": "9.2.8",
    "@tanstack/react-virtual": "3.14.14",
    "@xyflow/react": "12.12.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.54.0",
    "minisearch": "7.2.0",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/leaflet": "1.9.22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "engines": {
    "node": ">=24"
